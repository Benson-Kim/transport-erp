# ---------------------------------------------------------------------------
# Transport ERP - environment example (#24)
# Copy to .env.local (dev) or .env.production and fill in real values.
# Only the variables the application actually reads are listed here.
# ---------------------------------------------------------------------------

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Transport ERP"

# Database (PostgreSQL). Use a pooled URL for the app; DIRECT_URL is the
# non-pooled connection used for migrations if you enable it in schema.prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/transport_erp?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/transport_erp?schema=public"

# Authentication (NextAuth v5). AUTH_SECRET is REQUIRED in every environment
# (v5 throws MissingSecret without it - it does not auto-derive a dev secret).
# Generate one with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# OAuth - Google (optional; enables the Google sign-in button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signup allow-list (#23). Who may obtain a NEW account - via Google OAuth
# auto-provisioning or the /register form. Comma-separated, case-insensitive;
# domains match the part after '@' exactly (no subdomains). Existing active
# users always keep working. LEAVE EMPTY TO DENY ALL NEW SIGN-UPS (default).
# Example: AUTH_ALLOWED_SIGNUP_DOMAINS=acme.es,transportes-acme.com
AUTH_ALLOWED_SIGNUP_DOMAINS=
AUTH_ALLOWED_SIGNUP_EMAILS=

# Self-service registration (#35). The /register page and its server action
# are enabled only when this is exactly "true" (fail closed). Even when
# enabled, new accounts must still pass the signup allow-list above.
ENABLE_USER_REGISTRATION=false

# Email (Resend). Required to send verification / reset / notification mail.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME="Transport ERP"
EMAIL_REPLY_TO=
# Environment guardrails for outbound mail (comma-separated).
EMAIL_ENABLE_SENDING=false
EMAIL_TEST_RECIPIENTS=
EMAIL_ALLOWED_DOMAINS=

# File storage (Backblaze B2, S3-compatible). Required at boot; the storage
# client throws if these are unset.
B2_ENDPOINT=
B2_REGION=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=
B2_CDN_URL=
B2_MAX_FILE_SIZE=10485760

# Server Actions allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# Development tools
NEXT_TELEMETRY_DISABLED=1
ANALYZE=false
